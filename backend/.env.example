# Copy to .env for local backend development.
DATABASE_URL=sqlite:///./ats_suite.db
# Comma-separated origins for CORS (credentials disabled; "*" not allowed).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS_PROD=
# Optional LLM key (prefer env/secret management over DB storage).
GEMINI_API_KEY=
DEFAULT_LLM_PROVIDER=gemini
# Local Hugging Face model (<=3B, default Qwen3-1.7B). Server-side only.
# Either set a direct GGUF path for llama-cpp-python (Q4 recommended on CPU),
# or leave empty to load LOCAL_HF_MODEL_ID via transformers when installed.
LOCAL_HF_MODEL_ID=Qwen/Qwen3-1.7B
LOCAL_HF_GGUF_PATH=
LOCAL_HF_N_CTX=4096
MAX_UPLOAD_BYTES=10485760
MAX_JOB_TEXT_CHARS=20000
